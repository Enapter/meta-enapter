# SPDX-License-Identifier: Apache-2.0

set menu_color_normal=white/black
set menu_color_highlight=black/light-gray

set ORDER="A B"
set A_OK=0
set A_TRY=0
set B_OK=0
set B_TRY=0
set INDEX=""
set OK=-1
set default="SlotA"
set fallback="SlotB"

set timeout=2

search --set=config_part --label enp-config

# GRUB has no string manipulation operations, so we cannot extract the disk
# number from a partition device string like "hd3,gpt2". Enumerate all known
# patterns explicitly instead. Supports up to 8 disks (hd0-hd7).
if [ "${config_part}" == "hd0,gpt2" ]; then
  set config_disk="hd0"
elif [ "${config_part}" == "hd1,gpt2" ]; then  
  set config_disk="hd1"
elif [ "${config_part}" == "hd2,gpt2" ]; then
  set config_disk="hd2"
elif [ "${config_part}" == "hd3,gpt2" ]; then
  set config_disk="hd3"
elif [ "${config_part}" == "hd4,gpt2" ]; then
  set config_disk="hd4"
elif [ "${config_part}" == "hd5,gpt2" ]; then
  set config_disk="hd5"
elif [ "${config_part}" == "hd6,gpt2" ]; then
  set config_disk="hd6"
elif [ "${config_part}" == "hd7,gpt2" ]; then
  set config_disk="hd7"
fi

set kernel_a_part="(${config_disk},gpt3)"
set root_a_part="(${config_disk},gpt4)"
set app_a_part="(${config_disk},gpt5)"
set kernel_b_part="(${config_disk},gpt6)"
set root_b_part="(${config_disk},gpt7)"
set app_b_part="(${config_disk},gpt8)"

probe --part-uuid --set=kernel_a_part_uuid ${kernel_a_part}
probe --part-uuid --set=root_a_part_uuid ${root_a_part}
probe --part-uuid --set=app_a_part_uuid ${app_a_part}
probe --part-uuid --set=kernel_b_part_uuid ${kernel_b_part}
probe --part-uuid --set=root_b_part_uuid ${root_b_part}
probe --part-uuid --set=app_b_part_uuid ${app_b_part}

set env_path="($config_part)/grubenv"

load_env --file "$env_path"

# Check if enapter_systemd_machine_id is set
if [ -n "${enapter_systemd_machine_id}" ]; then
  set systemd_bootargs="systemd.machine_id=${enapter_systemd_machine_id}"
else
  set systemd_bootargs="systemd.condition-first-boot=true"
fi

set common_params="panic=20 ${systemd_bootargs}"
export common_params

# Safety fallback: if both slots have exhausted all retry attempts (TRY=0),
# reset both to 1 so the system can attempt to boot rather than being
# permanently locked out. If this triggers repeatedly it indicates both
# slots are broken and manual recovery is needed.
if [ "$A_TRY" -eq 0 -a "$B_TRY" -eq 0 ]; then
  A_TRY=1
  B_TRY=1
fi

set DISPLAY_A_TRY=$A_TRY
set DISPLAY_B_TRY=$B_TRY

# select bootable slot
for SLOT in $ORDER; do
  if [ "$SLOT" == "A" ]; then
    if [ "$A_TRY" -eq 0 ]; then
      A_OK=0
    fi
    if [ "$A_TRY" -ge 0 ]; then
      # Decrement A_TRY with explicit conditionals
      if [ "${A_TRY}" == "5" ]; then
        set A_TRY=4
      elif [ "${A_TRY}" == "4" ]; then
        set A_TRY=3
      elif [ "${A_TRY}" == "3" ]; then
        set A_TRY=2
      elif [ "${A_TRY}" == "2" ]; then
        set A_TRY=1
      elif [ "${A_TRY}" == "1" ]; then
        set A_TRY=0
      fi
    fi
    INDEX="SlotA"
    OK=$A_OK
  fi
  if [ "$SLOT" == "B" ]; then
    if [ "$B_TRY" -eq 0 ]; then
      B_OK=0
    fi
    if [ "$B_TRY" -ge 0 ]; then
      # Decrement B_TRY with explicit conditionals
      if [ "${B_TRY}" == "5" ]; then
        set B_TRY=4
      elif [ "${B_TRY}" == "4" ]; then
        set B_TRY=3
      elif [ "${B_TRY}" == "3" ]; then
        set B_TRY=2
      elif [ "${B_TRY}" == "2" ]; then
        set B_TRY=1
      elif [ "${B_TRY}" == "1" ]; then
        set B_TRY=0
      fi
    fi
    INDEX="SlotB"
    OK=$B_OK
  fi
  if [ "$OK" -eq 1 ]; then
      default="$INDEX"
      if [ "$default" == "SlotA" ]; then
        fallback="SlotB"
      else
        fallback="SlotA"
      fi
      break
  fi
done

save_env --file "$env_path" A_OK A_TRY B_OK B_TRY

if [ "$default" == "SlotA" ]; then
  set active_slot="A"
  set active_kernel_part="${kernel_a_part}"
  set active_root_part_uuid="${root_a_part_uuid}"
  set active_app_part_uuid="${app_a_part_uuid}"
else
  set active_slot="B"
  set active_kernel_part="${kernel_b_part}"
  set active_root_part_uuid="${root_b_part_uuid}"
  set active_app_part_uuid="${app_b_part_uuid}"
fi

set active_slot_params="rauc.slot=${active_slot} root=PARTUUID=${active_root_part_uuid} app=PARTUUID=${active_app_part_uuid}"

export active_slot_params
export active_kernel_part

########################
# Menu entries         #
########################

menuentry "Enapter Linux Slot A (OK: $A_OK, TRY: $DISPLAY_A_TRY)" --id SlotA {
echo 'Loading Linux Kernel ...'
linux $kernel_a_part/bzImage $common_params rauc.slot=A root=PARTUUID=${root_a_part_uuid} app=PARTUUID=${app_a_part_uuid}
echo 'Loading initial ramdisk ...'
initrd $kernel_a_part/initrd
}

menuentry "Enapter Linux Slot B (OK: $B_OK, TRY: $DISPLAY_B_TRY)" --id SlotB {
echo 'Loading Linux Kernel ...'
linux $kernel_b_part/bzImage $common_params rauc.slot=B root=PARTUUID=${root_b_part_uuid} app=PARTUUID=${app_b_part_uuid}
echo 'Loading initial ramdisk ...'
initrd $kernel_b_part/initrd
}

menuentry 'UEFI Firmware Settings' {
fwsetup
}

submenu 'Advanced Options for Enapter Linux' {

menuentry 'Enapter Linux (Safe Graphics)' {
echo 'Loading Linux Kernel ...'
linux $active_kernel_part/bzImage $common_params nomodeset $active_slot_params
echo 'Loading initial ramdisk ...'
initrd $active_kernel_part/initrd
}

menuentry 'Enapter Linux (Password Reset)' {
echo 'Loading Linux Kernel ...'
linux $active_kernel_part/bzImage $common_params password_reset $active_slot_params
echo 'Loading initial ramdisk ...'
initrd $active_kernel_part/initrd
}

menuentry 'Enapter Linux (Factory Reset)' {
echo 'Loading Linux Kernel ...'
linux $active_kernel_part/bzImage $common_params factory_reset $active_slot_params
echo 'Loading initial ramdisk ...'
initrd $active_kernel_part/initrd
}

menuentry 'Enapter Linux (initrd Debug)' {
echo 'Loading Linux Kernel ...'
linux $active_kernel_part/bzImage $common_params init_fatal_sh=true verbose=true debug=true shell-debug $active_slot_params
echo 'Loading initial ramdisk ...'
initrd $active_kernel_part/initrd
}

menuentry 'Enapter Linux (initrd Shell)' {
echo 'Loading Linux Kernel ...'
linux $active_kernel_part/bzImage $common_params shell=after:udev init_fatal_sh=true $active_slot_params
echo 'Loading initial ramdisk ...'
initrd $active_kernel_part/initrd
}

}
